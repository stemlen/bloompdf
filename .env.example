# Server-backed converters (Word / PowerPoint / Excel / HTML → PDF).
# The site is a static export; these tools call same-origin POST /api/convert,
# served by a Cloudflare Pages Function (functions/api/convert.ts, not yet built).
# Leave unset (or anything but "true") until that backend is deployed: the UI then
# shows a "temporarily unavailable" state and sends no request.
NEXT_PUBLIC_CONVERT_ENABLED=false
